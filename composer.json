{
    "name": "m6web/monolog-extra-bundle",
    "type": "symfony-bundle",
    "description": "Provide extra features for Monolog",
    "keywords": ["log", "logging"],
    "homepage": "https://github.com/M6Web/MonologExtraBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "M6Web",
            "email": "opensource@m6web.fr",
            "homepage": "http://tech.m6web.fr/"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "~5.0 || ~6.0 || ~7.0",
        "symfony/monolog-bundle": "~3.0",
        "symfony/expression-language": "~5.0 || ~6.0 || ~7.0",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "atoum/atoum": "~4.0",
        "symfony/yaml": "~5.0 || ~6.0 || ~7.0",
        "rector/rector": "^2.4",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "autoload": {
        "psr-0": { "": "src/" }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
